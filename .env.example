# TripOS environment template.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every variable here is validated at startup by libs/shared/config — a missing or
# malformed value fails the boot with a readable message rather than surfacing as
# `undefined` deep in a request (CLAUDE.md §14).
#
# Add a variable to the Zod schema in libs/shared/config and to this file in the
# same commit, or the two drift.

# --- Runtime -------------------------------------------------------------
# NOTE: do NOT set NODE_ENV here. Next.js auto-loads .env for every command, so a
# `NODE_ENV=development` line makes `next build` emit a production bundle while
# React resolves its development runtime — which fails prerendering with an
# opaque "Cannot read properties of null (reading 'useContext')". NODE_ENV is set
# by the tooling (next/nx/docker), never by this file.
PORT=3000
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200

# --- Datastores ----------------------------------------------------------
# Matches docker/docker-compose.yml. Start them with `pnpm db:up`.
# Non-default host ports (55432 / 56379) so TripOS never collides with natively
# installed PostgreSQL or Redis servers — see docker/docker-compose.yml for the
# failure mode this avoids. Use 127.0.0.1 rather than `localhost`: on Windows,
# `localhost` may resolve to ::1 first and pick a different listener.
DATABASE_URL=postgresql://tripos:tripos@127.0.0.1:55432/tripos?schema=public
REDIS_URL=redis://127.0.0.1:56379

# --- Authentication (Clerk — ADR-0003) -----------------------------------
# Create an application at https://dashboard.clerk.com and paste the keys.
# NEXT_PUBLIC_* values are embedded in the client bundle: treat them as public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for the user-sync webhook. Verify every payload against this —
# an unverified webhook lets anyone create or delete users. Found under
# Configure → Webhooks in the Clerk dashboard after adding an endpoint.
CLERK_WEBHOOK_SIGNING_SECRET=

# Local webhook delivery. Clerk's servers cannot reach localhost, so the Clerk
# CLI relays deliveries to your machine instead of you exposing a tunnel:
#
#   clerk webhooks listen --token $CLERK_WEBHOOK_RELAY_TOKEN \
#     --forward-to http://localhost:3000/api/webhooks/clerk
#
# Pinning the token keeps the relay inbox URL stable, so the endpoint registered
# in the Clerk dashboard keeps working across restarts. Generate one with
# `clerk webhooks token`. Dev convenience only — not used in deployed
# environments, which receive deliveries directly.
CLERK_WEBHOOK_RELAY_TOKEN=

# Route configuration, written by `clerk init`. These match the catch-all routes
# at apps/web/src/app/sign-in and sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Frontend ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api
