{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "target": "ES2023",
    "lib": ["ES2023"],
    "sourceMap": true,
    "declaration": false,
    "importHelpers": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "paths": {
      "@tripos/shared/config": ["./libs/shared/config/src/index.ts"],
      "@tripos/shared/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@tripos/shared/database": ["./libs/shared/database/src/index.ts"],
      "@tripos/web/shared/data-access": ["./libs/web/shared/data-access/src/index.ts"],
      "@tripos/shared/ui": ["./libs/shared/ui/src/index.ts"],
      "@tripos/api/shared/database": ["./libs/api/shared/database/src/index.ts"],
      "@tripos/api/users/domain": ["./libs/api/users/domain/src/index.ts"],
      "@tripos/api/users/application": ["./libs/api/users/application/src/index.ts"],
      "@tripos/api/users/infrastructure": ["./libs/api/users/infrastructure/src/index.ts"],
      "@tripos/api/users/feature": ["./libs/api/users/feature/src/index.ts"],
      "@tripos/api/shared/authz": ["./libs/api/shared/authz/src/index.ts"],
      "@tripos/api/shared/auth": ["./libs/api/shared/auth/src/index.ts"],
      "@tripos/api/shared/trip-access": ["./libs/api/shared/trip-access/src/index.ts"],
      "@tripos/api/trips/domain": ["./libs/api/trips/domain/src/index.ts"],
      "@tripos/api/trips/application": ["./libs/api/trips/application/src/index.ts"],
      "@tripos/api/trips/infrastructure": ["./libs/api/trips/infrastructure/src/index.ts"],
      "@tripos/api/trips/feature": ["./libs/api/trips/feature/src/index.ts"],
      "@tripos/web/trips/data-access": ["./libs/web/trips/data-access/src/index.ts"],
      "@tripos/web/trips/feature": ["./libs/web/trips/feature/src/index.ts"],
      "@tripos/api/polls/domain": ["./libs/api/polls/domain/src/index.ts"],
      "@tripos/api/polls/application": ["./libs/api/polls/application/src/index.ts"],
      "@tripos/api/polls/infrastructure": ["./libs/api/polls/infrastructure/src/index.ts"],
      "@tripos/api/polls/feature": ["./libs/api/polls/feature/src/index.ts"],
      "@tripos/api/shared/testing": ["./libs/api/shared/testing/src/index.ts"],
      "@tripos/web/polls/data-access": ["./libs/web/polls/data-access/src/index.ts"],
      "@tripos/web/polls/feature": ["./libs/web/polls/feature/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
