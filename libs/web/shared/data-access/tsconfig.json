{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    // `bundler` resolution so TypeScript honours package `exports` maps — the
    // oRPC packages are ESM-only and publish types only through that field.
    // This library is bundled by Next, never emitted standalone.
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "importHelpers": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
