{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // `bundler` resolution so TypeScript honours package `exports` maps. The
    // oRPC packages are ESM-only and publish types solely through `exports`;
    // the default `node10` resolution ignores that field and reports
    // "Cannot find module '@orpc/contract'". This library is never emitted on
    // its own (bundler=none) — consumers compile it — so these settings govern
    // type-checking only.
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "importHelpers": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
