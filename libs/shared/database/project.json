{
  "name": "shared-database",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/database/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:util", "domain:shared"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "tsc -p libs/shared/database/tsconfig.lib.json --noEmit",
          "tsc -p libs/shared/database/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
