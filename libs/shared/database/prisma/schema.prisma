// TripOS database schema.
//
// libs/shared/database is the SOLE owner of this file and of the generated
// client (CLAUDE.md §8). No other library imports @prisma/client directly;
// repositories in `infrastructure` layers import from this library instead.
//
// Conventions enforced here:
//   - every table carries id / createdAt / updatedAt
//   - mutable user content also carries deletedAt (soft delete) and actor columns
//   - snake_case table names via @@map, camelCase in TypeScript
//   - money is NEVER a float (ADR-0005); no monetary columns exist yet
//
// M0 defines only `User`, which is the identity boundary from ADR-0003.
// Trip and TripMembership arrive in M1 with the authorization layer.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 removed `url` from the datasource block. The migration/introspection
// connection string now lives in prisma.config.ts at the repo root, and the
// runtime client connects through a driver adapter (@prisma/adapter-pg) rather
// than a bundled query engine. See ADR-0011.
datasource db {
  provider = "postgresql"
}

/// The canonical user record inside TripOS.
///
/// Clerk owns authentication; this table owns identity as the rest of the system
/// sees it (ADR-0003). `clerkUserId` appears in exactly this one column and
/// nowhere else in the schema — every other table references `User.id`. That is
/// what makes changing identity provider a re-mapping of one column rather than a
/// migration of the entire database.
model User {
  id String @id @default(cuid())

  /// Clerk's subject identifier. The ONLY reference to Clerk in the schema.
  clerkUserId String @unique @map("clerk_user_id")

  email       String  @unique
  displayName String  @map("display_name")
  avatarUrl   String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Soft delete. Account deletion must preserve ledger integrity for trips the
  /// user participated in, so rows are anonymised rather than removed
  /// (docs/prd-review.md §4.9).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships   TripMembership[]
  createdTrips  Trip[]           @relation("TripCreatedBy")
  sentInvites   TripInvite[]     @relation("TripInviteCreatedBy")
  votes         Vote[]

  @@index([deletedAt])
  @@map("users")
}

/// Where a trip sits in its lifecycle. Gates behaviour across the product:
/// when voting closes, when live location is permitted, when Trip Replay
/// generates, and what is still editable (docs/prd-review.md §4.5).
enum TripStatus {
  DRAFT
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("trip_status")
}

/// Authorization roles (ADR-0006). VIEWER exists for the real case of someone
/// who funds or follows a trip without participating in it.
enum TripRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("trip_role")
}

/// Membership state. Removed members keep their row: their expenses and
/// messages must survive, or the group's balances break (ADR-0005).
enum TripMembershipStatus {
  ACTIVE
  REMOVED

  @@map("trip_membership_status")
}

model Trip {
  id String @id @default(cuid())

  name        String
  description String?
  destination String?

  /// IANA timezone, e.g. "Asia/Kolkata". Required: itinerary times render in
  /// trip-local time by default, not viewer-local (CLAUDE.md §9).
  timezone String

  /// ISO-4217 base currency. Every expense stores its own currency plus a
  /// snapshot of the rate to this one, so historical totals never move when a
  /// rate does (ADR-0005). Present from day one even while the UI is
  /// single-currency, because retrofitting currency is a brutal migration.
  baseCurrency String @default("INR") @map("base_currency") @db.Char(3)

  /// Date-only, NOT instants. A trip starting on the 3rd starts on the 3rd in
  /// every timezone; storing an instant would shift it across a date boundary
  /// (CLAUDE.md §9).
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  status TripStatus @default(PLANNING)

  coverImageUrl String? @map("cover_image_url")

  createdById String @map("created_by_id")
  createdBy   User   @relation("TripCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships TripMembership[]
  invites     TripInvite[]
  polls       Poll[]

  @@index([status])
  @@index([deletedAt])
  @@map("trips")
}

/// What a poll decides.
///
/// PRD §9 lists destination, date, activity, restaurant and hotel voting as five
/// separate features. They are ONE primitive with this discriminator
/// (docs/prd-review.md §4.4) — five implementations would mean five
/// half-correct handlings of ties, deadlines and vote changes.
enum PollSubject {
  DESTINATION
  DATES
  ACTIVITY
  RESTAURANT
  ACCOMMODATION
  GENERAL

  @@map("poll_subject")
}

enum PollKind {
  /// Pick exactly one. Casting a new vote replaces the previous one.
  SINGLE_CHOICE
  /// Approval voting — tick everything acceptable. Far better than
  /// single-choice for "which of these restaurants would you be happy with".
  MULTIPLE_CHOICE

  @@map("poll_kind")
}

enum PollStatus {
  OPEN
  CLOSED

  @@map("poll_status")
}

model Poll {
  id String @id @default(cuid())

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  subject  PollSubject
  kind     PollKind    @default(SINGLE_CHOICE)
  status   PollStatus  @default(OPEN)
  question String

  /// Optional deadline. A poll past it is closed for voting even while its
  /// status is still OPEN — the transition is applied lazily rather than by a
  /// scheduler, so there is no window where a late vote slips in.
  closesAt DateTime? @map("closes_at") @db.Timestamptz(6)

  /// Whether members may add options themselves, or only the organiser.
  allowMemberOptions Boolean @default(true) @map("allow_member_options")

  /// The outcome, recorded when the poll closes. Nullable because a poll can be
  /// closed with no decision (everyone abstained, or the group moved on).
  decidedOptionId String?     @unique @map("decided_option_id")
  decidedOption   PollOption? @relation("PollDecision", fields: [decidedOptionId], references: [id])
  closedAt        DateTime?   @map("closed_at") @db.Timestamptz(6)

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  options PollOption[] @relation("PollOptions")
  votes   Vote[]

  @@index([tripId, status])
  @@map("polls")
}

model PollOption {
  id String @id @default(cuid())

  pollId String @map("poll_id")
  poll   Poll   @relation("PollOptions", fields: [pollId], references: [id], onDelete: Cascade)

  label       String
  description String?
  /// A booking page, map pin, or menu — the reference TripOS stores rather than
  /// the inventory it deliberately does not (PRD §3).
  url         String?

  /// Set only for DATES polls. Date-only, never instants: a trip starting on the
  /// 3rd starts on the 3rd in every timezone (CLAUDE.md §9).
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  votes       Vote[]
  decidedFor  Poll?  @relation("PollDecision")

  @@index([pollId])
  @@map("poll_options")
}

model Vote {
  id String @id @default(cuid())

  pollId   String     @map("poll_id")
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String     @map("option_id")
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// One vote per person per option. For SINGLE_CHOICE the use case additionally
  /// clears the voter's other votes, so "change your vote" works — a gap the PRD
  /// left open (docs/prd-review.md §4.14).
  @@unique([optionId, userId])
  @@index([pollId, userId])
  @@map("votes")
}

/// The authorization root (ADR-0006).
///
/// Every trip-scoped permission decision in the product resolves to a row here.
/// `TripAccessGuard` loads it once per request; nothing trusts a client-supplied
/// role or trip id.
model TripMembership {
  id String @id @default(cuid())

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  role   TripRole
  status TripMembershipStatus @default(ACTIVE)

  invitedById String?   @map("invited_by_id")
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// One membership per person per trip. The database enforces it so a double
  /// invite-accept cannot create two rows with conflicting roles.
  @@unique([tripId, userId])
  /// The guard's hot path: "which trips can this user see, and as what".
  @@index([userId, status])
  @@index([tripId, status])
  @@map("trip_memberships")
}

/// An invitation to join a trip.
///
/// A trip with one member has no value, so this is the most important flow in
/// the product (docs/prd-review.md §4.8) — and an unbounded invite endpoint is a
/// spam vector, hence expiry, use limits, and revocation.
model TripInvite {
  id String @id @default(cuid())

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  /// SHA-256 of the invite token, never the token itself. The raw token is shown
  /// to the inviter once and never stored — a leaked database backup must not
  /// hand out trip access, exactly as with passwords.
  tokenHash String @unique @map("token_hash")

  /// Role granted on acceptance. Never OWNER — ownership transfers explicitly.
  role TripRole @default(MEMBER)

  /// Optional. Set for an invite addressed to one person; null for a share link.
  email String?

  createdById String @map("created_by_id")
  createdBy   User   @relation("TripInviteCreatedBy", fields: [createdById], references: [id])

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  maxUses   Int?      @map("max_uses")
  useCount  Int       @default(0) @map("use_count")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tripId, revokedAt])
  @@map("trip_invites")
}
