{
  "name": "api-trips-infrastructure",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/trips/infrastructure/src",
  "projectType": "library",
  "tags": ["scope:api", "type:infrastructure", "domain:trips"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "tsc -p libs/api/trips/infrastructure/tsconfig.lib.json --noEmit",
          "tsc -p libs/api/trips/infrastructure/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/api/trips/infrastructure",
        "command": "vitest run --config vitest.integration.config.mts"
      }
    }
  }
}
