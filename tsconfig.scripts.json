{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Workspace scripts run through tsx (ESM), and they import the oRPC packages
    // which publish types only via `exports` maps — hence bundler resolution.
    "module": "esnext",
    "moduleResolution": "bundler",
    // Scripts may import Nest-decorated adapters (e.g. PrismaUserRepository in
    // the user backfill), so the legacy decorator transform must be enabled or
    // esbuild refuses to parse them.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["scripts/**/*.ts"]
}
